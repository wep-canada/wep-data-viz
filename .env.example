# Copy to .env for local use. None of these are secrets and all have working defaults.
# The only key is the free CARTO basemap key below. If you add a source that needs one, such as
# NASA FIRMS, put it in GitHub Actions secrets and Posit Connect Cloud environment variables,
# never in git.

# Where the running app looks for machine-written data (default: ./data)
# WEPDASH_DATA_DIR=./data

# Fetch the live feeds when the app is opened (1) or only read saved snapshots (0)
WEPDASH_LIVE_FETCH=1

# How long a live fetch is cached, in seconds
WEPDASH_LIVE_TTL=900

# Seconds before giving up on a source
WEPDASH_HTTP_TIMEOUT=20

# Free CARTO basemap key (https://carto.com/basemaps/apikey). Leave empty to show the map with a
# watermark. Restrict it to your websites in CARTO's key settings, since browsers can see it.
WEPDASH_CARTO_KEY=

# Sent in the User-Agent so data providers can contact you (use a real contact address)
WEPDASH_CONTACT=your-email@example.org
